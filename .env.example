# Base URL of your ERP API. In dev, /api is proxied to the backend (see vite.config.ts).
API_BASE_URL=/api
# Dev-only: backend address for the /api proxy. Defaults to http://localhost:8100.
# API_PROXY_TARGET=http://localhost:8100
# Dev-only: serve requests from src/lib/mocks, except LIVE_PREFIXES in
# src/lib/constants/endpoints.ts, which always hit the real API. Must be false in production.
API_MOCK=false
